# GigaChat (опционально). Без ключа сервис работает в демо-режиме на Atlas Engine.
# Ключ авторизации из личного кабинета GigaChat API.
GIGACHAT_CREDENTIALS=
# Альтернативное имя переменной, если ключ хранится как «авторизационный ключ».
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TEMPERATURE=0.65
# Для локальной разработки с самоподписанным сертификатом GigaChat.
GIGACHAT_VERIFY_SSL=false
GIGACHAT_TIMEOUT_MS=40000

# Сервер
PORT=5173
HOST=127.0.0.1
# Минимальная задержка генерации, чтобы успевал проиграться экран загрузки.
MIN_GENERATION_MS=1100
