{
  "name": "atlas-travel",
  "version": "1.0.0",
  "private": true,
  "description": "Атлас — ИИ-сервис для планирования путешествий: маршрут, отели, бюджет и план на каждый день",
  "main": "./src/index.tsx",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "serve": "node server/index.mjs --prod",
    "preview": "node server/index.mjs --prod",
    "typecheck": "tsc --noEmit",
    "sync:countries": "node scripts/sync-countries.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node tests/generator.test.mjs",
    "brojs:build": "brojs compile",
    "brojs:serve": "brojs prom-server --port 8099"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/prata": "^5.2.8",
    "@langchain/core": "^0.3.80",
    "@reduxjs/toolkit": "^2.9.2",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "langchain-gigachat": "^0.0.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@brojs/cli": "^2.0.1",
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
